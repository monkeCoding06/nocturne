# Generates the embedded copy of presets/*.json (single source of truth).
# Usage: cmake -DPRESET_DIR=<dir> -DOUT=<file.cpp> -P EmbedPresets.cmake
# The JSON bytes are emitted as unsigned char arrays (no string-literal size limits on MSVC).
cmake_minimum_required(VERSION 3.20)

if(NOT PRESET_DIR OR NOT OUT)
  message(FATAL_ERROR "EmbedPresets: PRESET_DIR and OUT are required")
endif()

file(STRINGS "${PRESET_DIR}/index.txt" index_lines)
set(ids "")
foreach(line IN LISTS index_lines)
  string(STRIP "${line}" line)
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  list(APPEND ids "${line}")
endforeach()
if(NOT ids)
  message(FATAL_ERROR "EmbedPresets: ${PRESET_DIR}/index.txt lists no presets")
endif()

file(GLOB on_disk RELATIVE "${PRESET_DIR}" "${PRESET_DIR}/*.json")
foreach(f IN LISTS on_disk)
  string(REGEX REPLACE "\\.json$" "" stem "${f}")
  if(NOT stem IN_LIST ids)
    message(FATAL_ERROR "EmbedPresets: ${f} is not listed in presets/index.txt")
  endif()
endforeach()

set(NL "\n")
string(REPEAT "[0-9a-f]" 32 wrap_re)
set(arrays "")
set(table "")
set(i 0)
foreach(id IN LISTS ids)
  set(file "${PRESET_DIR}/${id}.json")
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "EmbedPresets: index.txt lists '${id}' but ${file} does not exist")
  endif()
  file(READ "${file}" text)
  string(JSON fmt ERROR_VARIABLE jerr GET "${text}" format)
  if(jerr OR NOT fmt STREQUAL "nocturne-patch")
    message(FATAL_ERROR "EmbedPresets: ${file} is not a valid nocturne patch: ${jerr}")
  endif()
  file(READ "${file}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "(${wrap_re})" "\\1${NL}" hex "${hex}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND arrays "static const unsigned char kData${i}[] = {${NL}${hex}${NL}};${NL}")
  string(APPEND table "    {\"${id}\", reinterpret_cast<const char*>(kData${i}), ${size}},${NL}")
  math(EXPR i "${i} + 1")
endforeach()

set(content "// GENERATED by cmake/EmbedPresets.cmake from presets/*.json - do not edit.${NL}")
string(APPEND content "#include \"patch/EmbeddedPresets.hpp\"${NL}${NL}namespace nocturne::embedded {${NL}namespace {${NL}")
string(APPEND content "${arrays}}  // namespace${NL}${NL}const Asset kPresetAssets[] = {${NL}${table}};${NL}")
string(APPEND content "const unsigned long kPresetAssetCount = ${i};${NL}${NL}}  // namespace nocturne::embedded${NL}")

if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
